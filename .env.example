# Optional AI integration. Copy into .env.local and configure locally.
# Never prefix these with NEXT_PUBLIC_ or commit real credentials.
WHYLAB_AI_ENABLED=false
OPENAI_API_KEY=
# Set a model available to your project that supports Responses structured outputs.
OPENAI_MODEL=
# Required for every paid OpenAI request. Use a long random deployment secret.
WHYLAB_ACCESS_TOKEN=
# Upstash-compatible Redis REST endpoint used for durable cross-instance quotas.
WHYLAB_QUOTA_REST_URL=
WHYLAB_QUOTA_REST_TOKEN=
# Optional dedicated Upstash-compatible Redis endpoint for 24-hour investigation snapshots.
# When omitted, the quota Redis endpoint above is reused.
WHYLAB_SESSION_REST_URL=
WHYLAB_SESSION_REST_TOKEN=
# Optional public origin used for absolute social metadata URLs. Defaults to production URL if unset.
NEXT_PUBLIC_SITE_URL=https://why-lab-gpt-astra.vercel.app
